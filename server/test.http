### Register
curl -X POST http://localhost:5000/api/auth/register
-H "Content-Type: application/json" \
-d
'{
  "name": "Test User",
  "email": "test@example.com",
  "password": "123456"
}'
###
curl -X POST http://localhost:5000/api/auth/login
-H "Content-Type: application/json" \
-d
'{
  "email": "test@example.com",
  "password": "123456"
}'